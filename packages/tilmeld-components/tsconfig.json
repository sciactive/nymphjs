{
  "extends": "@tsconfig/svelte/tsconfig.json",

  "compilerOptions": {
    "types": ["jest"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["DOM", "es2023"],
    "target": "es2023",
    "noImplicitAny": true,
    "strict": true,

    "removeComments": false,
    "sourceMap": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "rootDir": "src/",
    "declaration": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules/*"]
}
