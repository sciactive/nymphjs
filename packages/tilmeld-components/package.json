{
  "name": "@nymphjs/tilmeld-components",
  "version": "1.0.0-beta.119",
  "description": "Nymph.js - Tilmeld Front End Components",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "svelte": "dist/index.js",
  "exports": {
    "./package.json": {
      "types": "./package.json",
      "svelte": "./package.json"
    },
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "types": "src/index.d.ts",
  "keywords": [
    "nymph",
    "ORM",
    "object relational mapper"
  ],
  "scripts": {
    "clean": "test -d dist && rm -r dist || true",
    "build": "npm run build:js && npm run build:svelte",
    "build:js": "tsc -p . --outDir dist/ --rootDir src/",
    "build:svelte": "cp src/*.svelte dist/",
    "prepublish": "npm run clean && npm run build",
    "typecheck": "npx tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nymph.io",
  "repository": {
    "type": "git",
    "url": "https://forge.sciactive.com/sciactive/nymphjs.git",
    "directory": "packages/tilmeld-components"
  },
  "author": "Hunter Perrin <hperrin@port87.com>",
  "bugs": {
    "url": "https://forge.sciactive.com/sciactive/nymphjs/issues"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@nymphjs/tilmeld-client": "^1.0.0-beta.119",
    "@smui/button": "^9.0.2",
    "@smui/checkbox": "^9.0.2",
    "@smui/circular-progress": "^9.0.2",
    "@smui/dialog": "^9.0.2",
    "@smui/form-field": "^9.0.2",
    "@smui/radio": "^9.0.2",
    "@smui/textfield": "^9.0.2",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "svelte": "^5.56.10",
    "svelte-loader": "^3.2.4",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
