{
  "name": "@nymphjs/guid",
  "version": "1.0.0-beta.118",
  "description": "Nymph.js - GUID and Unique Code Generators",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nymph",
    "ORM",
    "object relational mapper",
    "guid"
  ],
  "scripts": {
    "clean": "test -d dist && rm -r dist || true",
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublish": "npm run clean && npm run build",
    "typecheck": "npx tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nymph.io",
  "repository": {
    "type": "git",
    "url": "https://forge.sciactive.com/sciactive/nymphjs.git",
    "directory": "packages/guid"
  },
  "author": "Hunter Perrin <hperrin@port87.com>",
  "bugs": {
    "url": "https://forge.sciactive.com/sciactive/nymphjs/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "luxon": "^3.7.2",
    "nanoid": "^6.0.1",
    "nanoid-dictionary": "^5.0.0",
    "sha1": "^1.1.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/nanoid-dictionary": "^4.2.3",
    "@types/node": "^26.2.0",
    "@types/sha1": "^1.1.5",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  }
}
