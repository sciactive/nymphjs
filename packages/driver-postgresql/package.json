{
  "name": "@nymphjs/driver-postgresql",
  "version": "1.0.0-beta.118",
  "description": "Nymph.js - PostgreSQL DB Driver",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nymph",
    "ORM",
    "object relational mapper"
  ],
  "scripts": {
    "clean": "test -d dist && rm -r dist || true",
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublish": "npm run clean && npm run build",
    "typecheck": "npx tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --watch",
    "test:db:start": "docker run --rm --name nymph-postgresql -e POSTGRES_USER=nymph -e POSTGRES_PASSWORD=nymph -p 5432:5432 postgres",
    "test:db:stop": "docker kill -s TERM nymph-postgresql"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nymph.io",
  "repository": {
    "type": "git",
    "url": "https://forge.sciactive.com/sciactive/nymphjs.git",
    "directory": "packages/driver-postgresql"
  },
  "author": "Hunter Perrin <hperrin@port87.com>",
  "bugs": {
    "url": "https://forge.sciactive.com/sciactive/nymphjs/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@nymphjs/guid": "^1.0.0-beta.118",
    "@nymphjs/nymph": "^1.0.0-beta.118",
    "@sciactive/tokenizer": "^3.4.0",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "pg-format": "^1.0.4"
  },
  "devDependencies": {
    "@nymphjs/tilmeld": "^1.0.0-beta.118",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/pg-format": "^1.0.5",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
