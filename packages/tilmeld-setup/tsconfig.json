{
  "extends": "@tsconfig/svelte/tsconfig.json",

  "compilerOptions": {
    "types": ["jest"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["DOM", "es2024"],
    "target": "es2024",
    "noImplicitAny": true,
    "strict": true,

    "removeComments": false,
    "sourceMap": true,
    "rootDir": "app/",
    "outDir": "dist/app",
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": ["app/**/*"],
  "exclude": ["node_modules/*"]
}
