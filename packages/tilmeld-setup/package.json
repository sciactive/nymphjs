{
  "name": "@nymphjs/tilmeld-setup",
  "version": "1.0.0-beta.119",
  "description": "Nymph.js - Tilmeld Setup App",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nymph",
    "ORM",
    "object relational mapper"
  ],
  "scripts": {
    "clean": "test -d dist && rm -r dist || true",
    "build": "npm run build:server && npm run build:app && npm run build:app:theme",
    "build:server": "tsc -p tsconfig.server.json",
    "build:app": "NODE_ENV=\"production\" rollup -c",
    "build:app:theme": "smui-theme compile dist/app/smui.css -i app/theme",
    "watch:server": "tsc --watch -p tsconfig.server.json",
    "watch:app": "NODE_ENV=\"development\" rollup -c --watch",
    "prepublish": "npm run clean && npm run build",
    "typecheck": "npx tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nymph.io",
  "repository": {
    "type": "git",
    "url": "https://forge.sciactive.com/sciactive/nymphjs.git",
    "directory": "packages/tilmeld-setup"
  },
  "author": "Hunter Perrin <hperrin@port87.com>",
  "bugs": {
    "url": "https://forge.sciactive.com/sciactive/nymphjs/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@nymphjs/nymph": "^1.0.0-beta.119",
    "@nymphjs/tilmeld": "^1.0.0-beta.119",
    "express": "^5.2.1",
    "locutus": "^3.0.36"
  },
  "devDependencies": {
    "@material/elevation": "^14.0.0",
    "@material/typography": "^14.0.0",
    "@mdi/js": "^7.4.47",
    "@nymphjs/client": "^1.0.0-beta.119",
    "@nymphjs/driver-sqlite3": "^1.0.0-beta.119",
    "@nymphjs/query-parser": "^1.0.0-beta.119",
    "@nymphjs/server": "^1.0.0-beta.119",
    "@nymphjs/tilmeld-client": "^1.0.0-beta.119",
    "@nymphjs/tilmeld-components": "^1.0.0-beta.119",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@smui/button": "^9.0.2",
    "@smui/card": "^9.0.2",
    "@smui/checkbox": "^9.0.2",
    "@smui/circular-progress": "^9.0.2",
    "@smui/common": "^9.0.2",
    "@smui/data-table": "^9.0.2",
    "@smui/dialog": "^9.0.2",
    "@smui/drawer": "^9.0.2",
    "@smui/fab": "^9.0.2",
    "@smui/form-field": "^9.0.2",
    "@smui/icon-button": "^9.0.2",
    "@smui/layout-grid": "^9.0.2",
    "@smui/list": "^9.0.2",
    "@smui/menu": "^9.0.2",
    "@smui/paper": "^9.0.2",
    "@smui/radio": "^9.0.2",
    "@smui/tab": "^9.0.2",
    "@smui/tab-bar": "^9.0.2",
    "@smui/textfield": "^9.0.2",
    "@smui/top-app-bar": "^9.0.2",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/svelte": "^5.0.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/locutus": "^0.0.8",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "navigo": "^8.11.1",
    "rollup": "^4.62.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.2.3",
    "smui-theme": "^9.0.3",
    "svelte": "^5.56.10",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  }
}
