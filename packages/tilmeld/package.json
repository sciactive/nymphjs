{
  "name": "@nymphjs/tilmeld",
  "version": "1.0.0-beta.120",
  "description": "Nymph.js - Tilmeld User and Group System",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nymph",
    "ORM",
    "object relational mapper"
  ],
  "scripts": {
    "clean": "test -d dist && rm -r dist || true",
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublish": "npm run clean && npm run build",
    "typecheck": "npx tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nymph.io",
  "repository": {
    "type": "git",
    "url": "https://forge.sciactive.com/sciactive/nymphjs.git",
    "directory": "packages/tilmeld"
  },
  "author": "Hunter Perrin <hperrin@port87.com>",
  "bugs": {
    "url": "https://forge.sciactive.com/sciactive/nymphjs/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@nymphjs/guid": "^1.0.0-beta.120",
    "@nymphjs/nymph": "^1.0.0-beta.120",
    "@sciactive/splitn": "^3.1.0",
    "email-templates": "^13.0.1",
    "express": "^5.2.1",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "locutus": "^3.0.36",
    "lodash-es": "^4.18.1",
    "otpauth": "^9.5.1",
    "pug": "^3.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@nymphjs/client": "^1.0.0-beta.120",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/recommended": "^1.0.13",
    "@types/email-templates": "^10.0.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/locutus": "^0.0.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
