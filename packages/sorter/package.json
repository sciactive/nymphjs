{
  "name": "@nymphjs/sorter",
  "version": "1.0.0-beta.115",
  "description": "Nymph.js - Sorter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nymph",
    "ORM",
    "object relational mapper"
  ],
  "scripts": {
    "clean": "test -d dist && rm -r dist || true",
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublish": "npm run clean && npm run build",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" npx jest",
    "test:watch": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" npx jest --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nymph.io",
  "repository": {
    "type": "git",
    "url": "https://forge.sciactive.com/sciactive/nymphjs.git",
    "directory": "packages/sorter"
  },
  "author": "Hunter Perrin <hperrin@port87.com>",
  "bugs": {
    "url": "https://forge.sciactive.com/sciactive/nymphjs/issues"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
